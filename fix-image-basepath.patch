diff --git a/lib/utils.ts b/lib/utils.ts
index bd0c391..796c730 100644
--- a/lib/utils.ts
+++ b/lib/utils.ts
@@ -4,3 +4,14 @@ import { twMerge } from "tailwind-merge"
 export function cn(...inputs: ClassValue[]) {
   return twMerge(clsx(inputs))
 }
+
+/**
+ * Prefix a /public path with the site's basePath.
+ * Plain <img> tags and <Image unoptimized> do NOT add basePath automatically,
+ * so "/me/photo.jpg" would be requested from the domain root instead of /portfolio/.
+ */
+export function asset(path: string): string {
+  if (/^(https?:)?\/\//.test(path) || path.startsWith("data:")) return path
+  const base = process.env.NEXT_PUBLIC_BASE_PATH ?? ""
+  return `${base}${path.startsWith("/") ? path : `/${path}`}`
+}
